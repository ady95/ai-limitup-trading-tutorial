# .env.example 을 .env 로 복사한 뒤 값을 채웁니다. .env 는 절대 커밋하지 않습니다.

# 한국투자증권 Open API — 실전투자 앱키 (이 책에서는 시세 조회에만 사용)
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

# 한국투자증권 Open API — 모의투자 앱키·계좌 (09장 주문 실습)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PROD=01
KIS_HTS_ID=

# 초당 호출 수 (기본: 실전 15, 모의 1). 장시간 수집 중 오류가 나면 낮춥니다
# KIS_RATE_PER_SEC=10

# Open DART (06장)
DART_API_KEY=

# OpenAI 호환 LLM API (06장)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
